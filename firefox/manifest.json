{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "26.10.19",
  "description": "__MSG_extDesc__",
  "default_locale": "zh_CN",
  "homepage_url": "https://github.com/hcllmsx/momoQRdecoder",
  "browser_specific_settings": {
    "gecko": {
      "id": "momoqrdecoder@hcllmsx.github.io",
      "strict_min_version": "154.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "src/img/icon16.png",
    "32": "src/img/icon32.png",
    "48": "src/img/icon48.png",
    "128": "src/img/icon128.png"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self' data: blob:; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; default-src 'self' data: blob:"
  },
  "sandbox": {
    "pages": ["src/sandbox.html"]
  },
  "background": {
    "scripts": [
      "src/jsQR.js",
      "src/cropAndDecodeQRCode.js",
      "src/background.js"
    ]
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "__MSG_extTitle__",
    "default_icon": {
      "16": "src/img/icon16.png",
      "32": "src/img/icon32.png",
      "48": "src/img/icon48.png",
      "128": "src/img/icon128.png"
    }
  }
}
