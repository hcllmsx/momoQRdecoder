{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "26.8.28.17",
  "description": "__MSG_extDesc__",
  "default_locale": "zh_CN",
  "homepage_url": "https://github.com/hcllmsx/momoQRdecoder",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "src/momoqr-logo-300px.png",
    "32": "src/momoqr-logo-300px.png",
    "48": "src/momoqr-logo-300px.png",
    "128": "src/momoqr-logo-300px.png"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "clipboardRead",
    "scripting",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' data: blob:; connect-src 'self' data: blob:; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; default-src 'self' data: blob:"
  },
  "sandbox": {
    "pages": ["src/sandbox.html"]
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "__MSG_extTitle__",
    "default_icon": "src/momoqr-logo-300px.png"
  }
}
