{
  "manifest_version": 3,
  "name": "默默二维码解码器",
  "version": "26.8.28.12",
  "description": "自动扫描当前网页二维码并解码，支持延迟扫描、复制和新标签页打开。",
  "homepage_url": "https://github.com/hcllmsx/momoQRdecoder",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "src/momoqrdecoder-icon.png",
    "32": "src/momoqrdecoder-icon.png",
    "48": "src/momoqrdecoder-icon.png",
    "128": "src/momoqrdecoder-icon.png"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "clipboardRead",
    "scripting",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' data: blob:; connect-src 'self' data: blob:; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; default-src 'self' data: blob:"
  },
  "sandbox": {
    "pages": ["src/sandbox.html"]
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "默默二维码解码器",
    "default_icon": "src/momoqrdecoder-icon.png"
  }
}
